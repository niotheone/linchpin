/* 1. THE SETUP */
* { box-sizing: border-box; }
p { margin: 0; margin-bottom: 12px; }

body {
  background-color: #f1f5f9;
  display: grid;
  gap: 30px;
  grid-template-columns: 1fr;
  margin: 0;
  min-height: 100vh;
  padding: 40px 0;
  place-items: center;
}

.slide-container {
  align-items: flex-start;
  background-color: #fff;
  border-radius: 12px;
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  font-family: 'Noto Sans KR', sans-serif;
  height: 720px;
  justify-content: flex-start;
  overflow: hidden;
  padding: 60px;
  position: relative;
  width: 1280px;
}

/* 1.1 BACKGROUND DECORATION */
.slide-container::before {
  content: '';
  position: absolute;
  top: 0; right: 0;
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(6, 78, 59, 0.05) 0%, transparent 70%);
  z-index: 0;
}

.slide-container>* { position: relative; z-index: 1; }

/* 2. TYPOGRAPHY */
h1, h2, h3 { color: #0f172a; font-family: 'Montserrat', 'Noto Sans KR', sans-serif; margin: 0; }
.slide-container p, .slide-container li, .slide-container td, .slide-container th { color: #334155; font-size: 19px; line-height: 1.5; }

.slide-container h1 { font-size: 68px; font-weight: 700; line-height: 1.1; color: #064e3b; }
.slide-container .slide-title { font-size: 44px; font-weight: 700; margin-bottom: 40px; border-left: 8px solid #064e3b; padding-left: 20px; width: 100%; text-align: left; }
.slide-container h3 { font-size: 30px; font-weight: 700; margin-bottom: 15px; color: #1e3a8a; }

.subtitle { font-size: 24px; color: #64748b; margin-top: 20px; font-weight: 300; }

.content-area {
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  justify-content: center;
  width: 100%;
}

/* 3. LAYOUTS */
.title-layout { text-align: center; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; }

.two-column { display: grid; grid-template-columns: 1fr 1fr; gap: 50px; width: 100%; height: 100%; align-items: center; }
.two-column.tiled > div { background-color: #f8fafc; border-radius: 16px; padding: 40px; border: 1px solid #e2e8f0; transition: transform 0.3s; }

.full-column-box { background-color: #f8fafc; border-radius: 16px; padding: 40px; border: 1px solid #e2e8f0; width: 100%; }

.tiled-content { display: flex; gap: 30px; width: 100%; align-items: stretch; }
.tile { flex: 1; padding: 35px; background: #f8fafc; border-radius: 16px; border-top: 6px solid #064e3b; text-align: center; }
.tile .icon { font-size: 50px; color: #064e3b; margin-bottom: 20px; }

.bullet-list ul { list-style: none; padding: 0; }
.bullet-list li { position: relative; padding-left: 45px; margin-bottom: 25px; }
.bullet-list i { position: absolute; left: 0; top: 5px; color: #064e3b; font-size: 24px; }

/* 4. CHARTS & TABLES */
.chart-container { width: 100%; display: flex; flex-direction: column; gap: 15px; }
.bar-group { display: flex; align-items: center; gap: 20px; margin-bottom: 10px; }
.bar-label { flex: 0 0 160px; text-align: right; font-weight: 700; color: #1e293b; }
.bar-rails { flex-grow: 1; height: 35px; background: #e2e8f0; border-radius: 18px; position: relative; overflow: hidden; display: flex; }
.bar-fill { height: 100%; display: flex; align-items: center; justify-content: flex-end; padding-right: 15px; color: white; font-weight: 700; font-size: 14px; }

.table-layout { width: 100%; }
table { width: 100%; border-collapse: collapse; border-radius: 12px; overflow: hidden; }
th { background: #064e3b; color: #fff; padding: 22px; text-align: left; font-size: 22px; }
td { padding: 18px 22px; border-bottom: 1px solid #e2e8f0; background: #fff; }
tr:last-child td { border-bottom: none; }
.price-tag { font-weight: 700; color: #064e3b; font-size: 22px; }

/* TIMELINE */
.timeline-layout { display: flex; justify-content: space-between; position: relative; width: 100%; padding: 40px 0; }
.timeline-line { position: absolute; top: 50%; left: 0; width: 100%; height: 3px; background: #e2e8f0; z-index: 0; }
.timeline-item { width: 30%; background: #fff; border: 1px solid #e2e8f0; padding: 25px; border-radius: 15px; z-index: 1; position: relative; }
.timeline-item::before { content: ''; position: absolute; top: 50%; left: -10px; width: 20px; height: 20px; background: #064e3b; border-radius: 50%; transform: translateY(-50%); }
.timeline-item h3 { font-size: 22px; color: #064e3b; }

/* AREA CHART */
.area-chart-container { padding: 20px; width: 100%; }
.area-chart-svg { width: 100%; height: 300px; }

/* DECORATIVE ELEMENTS */
.icon-focus { font-size: 120px; color: #f1f5f9; position: absolute; right: 60px; bottom: 60px; z-index: 0; }
    </style>
